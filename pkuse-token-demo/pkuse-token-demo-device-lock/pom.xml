<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.bdsoft</groupId>
	<artifactId>pkuse-token-demo-device-lock</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	
	<!-- SpringBoot -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<!--<version>2.3.0.RELEASE</version>-->
		<!-- <version>1.5.9.RELEASE</version> -->
		<relativePath/>
	</parent>
	
	<!-- 定义 Sa-Token 版本号 -->
	<properties>
		<pkuse-token.version>1.46.0</pkuse-token.version>
		<java.run.main.class>com.pj.PkuseTokenDeviceLockApplication</java.run.main.class>
	</properties>

	<dependencies>

		<!-- SpringBoot依赖 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		
		<!-- Sa-Token 权限认证, 在线文档：https://sa-token.com/ -->
		<dependency>
			<groupId>com.bdsoft</groupId>
			<artifactId>pkuse-token-spring-boot3-starter</artifactId>
			<version>${pkuse-token.version}</version>
		</dependency>

		<!-- Sa-Token整合 Redis -->
		<dependency>
			<groupId>com.bdsoft</groupId>
			<artifactId>pkuse-token-redisson-spring-boot-starter</artifactId>
			<version>${pkuse-token.version}</version>
		</dependency>
        
		<!-- 提供Redis连接池 -->
		<dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

	</dependencies>

</project>