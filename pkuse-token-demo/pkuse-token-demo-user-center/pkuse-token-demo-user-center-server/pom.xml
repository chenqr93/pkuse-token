<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bdsoft</groupId>
    <artifactId>pkuse-token-demo-user-center-server</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>pkuse-token-demo-user-center-server</name>
    <description>Pkuse-Token 用户中心示例（分层多模块）：common / model / service / api / web</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!--
        分层约定（依赖单向：web → api → service → model → common，无环）：
          usercenter-common   零内部依赖叶子：注解 / 业务异常 / 工具 / 平台配置定义（未来可引用部门 BOM）
          usercenter-model    数据模型：entity(PO) / bo / dto / vo
          usercenter-service  业务层：IService 接口 + ServiceImpl + Mapper（含自定义 XML）+ 日志/安全/验证码基础设施
          usercenter-api      对外接口层：Controller（HTTP 入口，聚合部署）
          usercenter-web      启动与装配：启动类 / Spring 配置 / 全局异常处理 / application.yml / db 脚本（可执行 jar）
    -->
    <modules>
        <module>usercenter-common</module>
        <module>usercenter-model</module>
        <module>usercenter-service</module>
        <module>usercenter-api</module>
        <module>usercenter-web</module>
    </modules>

    <properties>
        <revision>0.0.1-SNAPSHOT</revision>
        <java.version>17</java.version>
        <pkuse-token.version>1.46.0</pkuse-token.version>
        <mybatis-plus.version>3.5.14</mybatis-plus.version>
        <kingbase.version>8.6.0</kingbase.version>
        <netty.version>4.1.135.Final</netty.version>
        <tianai-captcha.version>1.5.3</tianai-captcha.version>
        <bcprov.version>1.81</bcprov.version>
        <druid.version>1.2.27</druid.version>
        <!-- 部门 Java Web 开发标准强制项：
             日志 Log4j2（要求 >= 2.22.1，版本由 spring-boot-starter-parent 管理，3.5.16 对应 2.24.3，满足要求）；
             SQL 监控 p6spy（要求 >= 1.9.0，采用 3.9.1）；运行监控 JavaMelody（要求 >= 2.5.0，采用 2.6.0） -->
        <p6spy.version>3.9.1</p6spy.version>
        <javamelody.version>2.6.0</javamelody.version>
    </properties>

    <!--
        打包环境：mvn package -P dev|test|uat|prod（默认 dev）。
        profiles.active 决定：
          1、application.yml 中 spring.profiles.active 的值（@profiles.active@ 资源过滤替换）；
          2、assembly 部署包 conf/ 中携带的环境配置文件 application-{profiles.active}.yml。
    -->
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <profiles.active>dev</profiles.active>
            </properties>
        </profile>
        <profile>
            <id>test</id>
            <properties>
                <profiles.active>test</profiles.active>
            </properties>
        </profile>
        <profile>
            <id>uat</id>
            <properties>
                <profiles.active>uat</profiles.active>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <profiles.active>prod</profiles.active>
            </properties>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <!-- 统一 Netty 各模块版本（pkuse-token-redisson 依赖中排除了 netty-codec，需应用自行补齐） -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>usercenter-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>usercenter-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>usercenter-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>usercenter-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方（版本由 spring-boot-starter-parent 管理的不在此重复声明） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 3.5.9+ 分页插件 / JSQLParser 独立模块 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.com.kingbase</groupId>
                <artifactId>kingbase8</artifactId>
                <version>${kingbase.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>pkuse-token-spring-boot3-starter</artifactId>
                <version>${pkuse-token.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>pkuse-token-sso</artifactId>
                <version>${pkuse-token.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>pkuse-token-redisson-spring-boot-starter</artifactId>
                <version>${pkuse-token.version}</version>
            </dependency>
            <dependency>
                <groupId>cloud.tianai.captcha</groupId>
                <artifactId>tianai-captcha</artifactId>
                <version>${tianai-captcha.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bcprov.version}</version>
            </dependency>
            <!-- 数据库连接池：Druid（SpringBoot3 专用 starter，要求 >= 1.2.18） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>
            <!-- SQL 监控（部门标准强制）：打印实际执行 SQL / 慢 SQL 检测；
                 数据源 url 需改为 jdbc:p6spy: 前缀、驱动改为 P6SpyDriver，配置见 spy.properties -->
            <dependency>
                <groupId>p6spy</groupId>
                <artifactId>p6spy</artifactId>
                <version>${p6spy.version}</version>
            </dependency>
            <!-- 运行监控（部门标准强制）：提供 /monitoring 监控页（强制依赖仅 javamelody-core + starter-aop） -->
            <dependency>
                <groupId>net.bull.javamelody</groupId>
                <artifactId>javamelody-spring-boot-starter</artifactId>
                <version>${javamelody.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- flatten 统一版本号管理（${revision} 展开到 install/deploy 的 POM） -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.3</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
