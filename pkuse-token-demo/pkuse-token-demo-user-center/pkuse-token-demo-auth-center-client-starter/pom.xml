<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bdsoft</groupId>
    <artifactId>pkuse-token-demo-auth-center-client-starter</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>pkuse-token-demo-auth-center-client-starter</name>
    <description>授权中心客户端 SDK：签名调用封装 + 权限缓存（陈旧兜底）+ StpInterface 适配 + 可选菜单端点；各应用引依赖写配置即接入</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>17</java.version>
        <pkuse-token.version>1.46.0</pkuse-token.version>
    </properties>

    <dependencies>
        <!-- 自动装配 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Web（AuthzClientController 可选暴露；请求对象解析） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JSON 解析（授权中心 /open/authz/* 响应） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Pkuse-Token（StpInterface 适配与菜单端点取当前登录用户；optional：NoSdk 应用不引入也可用签名调用与菜单端点前半部分能力） -->
        <dependency>
            <groupId>com.bdsoft</groupId>
            <artifactId>pkuse-token-spring-boot3-starter</artifactId>
            <version>${pkuse-token.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
