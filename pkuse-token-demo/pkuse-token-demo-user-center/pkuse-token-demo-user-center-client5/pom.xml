<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bdsoft</groupId>
    <artifactId>pkuse-token-demo-user-center-client5</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>pkuse-token-demo-user-center-client5</name>
    <description>SSO 客户端示例5（分层多模块）：common / model / service / api / web —— 模式三对接（跨域 + 跨 Redis，HTTP 接口校验 ticket；client3 的第二实例，演示同一模式下多应用接入）</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!--
        分层约定（依赖单向：web → api → service → model → common，无环），与用户中心 server 同风格：
          client5-common   通用层（零内部依赖叶子）：注解 / 业务异常 / 工具 / 配置定义（本示例暂无内容，保留分层脚手架）
          client5-model    数据模型层：entity(PO) / bo / dto / vo（本示例暂无内容，保留分层脚手架）
          client5-service  业务层：Service + Mapper + 域内支撑（本示例暂无内容，SSO 协议处理直接在 api 层演示）
          client5-api      对外接口层：Controller（SSO 协议入口 / 登录态 / 账号资料接口）
          client5-web      启动与装配：启动类 / Spring 配置（CORS、HttpTemplate）/ application.yml（可执行 jar）
    -->
    <modules>
        <module>client5-common</module>
        <module>client5-model</module>
        <module>client5-service</module>
        <module>client5-api</module>
        <module>client5-web</module>
    </modules>

    <properties>
        <revision>0.0.1-SNAPSHOT</revision>
        <java.version>17</java.version>
        <pkuse-token.version>1.46.0</pkuse-token.version>
        <netty.version>4.1.135.Final</netty.version>
        <mybatis-plus.version>3.5.14</mybatis-plus.version>
        <kingbase.version>8.6.0</kingbase.version>
        <druid.version>1.2.27</druid.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 统一 Netty 各模块版本（pkuse-token-redisson 依赖中排除了 netty-codec，需应用自行补齐） -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>client5-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>client5-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>client5-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>client5-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方（版本由 spring-boot-starter-parent 管理的不在此重复声明） -->
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>pkuse-token-spring-boot3-starter</artifactId>
                <version>${pkuse-token.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>pkuse-token-sso</artifactId>
                <version>${pkuse-token.version}</version>
            </dependency>
            <!-- 模式三：本应用使用自己的 Redis（spring.data.redis 配置），故不引入 alone-redisson -->
            <dependency>
                <groupId>com.bdsoft</groupId>
                <artifactId>pkuse-token-redisson-spring-boot-starter</artifactId>
                <version>${pkuse-token.version}</version>
            </dependency>

            <!-- ORM：MyBatis-Plus（版本与用户中心 server 对齐） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 注解（model 层仅用 @TableName / @TableId，不含持久层实现） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-annotation</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- 数据库：KingbaseES 驱动（与用户中心 server 同款数据库，可按需替换） -->
            <dependency>
                <groupId>cn.com.kingbase</groupId>
                <artifactId>kingbase8</artifactId>
                <version>${kingbase.version}</version>
            </dependency>

            <!-- 数据库连接池：Druid（替代默认 Hikari，连接池参数见 application.yml 的 spring.datasource.druid.*） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid-spring-boot-3-starter</artifactId>
                <version>${druid.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- flatten 统一版本号管理（${revision} 展开到 install/deploy 的 POM） -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.7.3</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
